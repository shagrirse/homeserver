{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(flux get:*)",
      "Bash(kubectl wait:*)",
      "Bash(just provision-check)",
      "Bash(just lint)",
      "Bash(just scan-history)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl annotate:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(flux reconcile:*)",
      "Bash(flux suspend:*)",
      "Bash(flux resume:*)",
      "Bash(flux delete:*)",
      "Bash(just provision)",
      "Bash(just provision :*)",
      "Bash(sops -d:*)",
      "Bash(sops --decrypt:*)",
      "Bash(sops decrypt:*)",
      "Bash(sops exec-env:*)",
      "Bash(sops exec-file:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Read(~/.config/sops/age/**)",
      "Read(**/*.agekey)",
      "Read(**/keys.txt)",
      "Read(**/.env)",
      "Read(**/provision/inventory.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit.sh" }
        ]
      }
    ]
  }
}
