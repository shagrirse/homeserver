{
  "uid": "flux",
  "title": "Flux",
  "tags": [
    "flux",
    "slo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO 4: Kustomizations Ready, 28 days",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "avg_over_time(((count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\", ready=\"True\"}) == bool count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\"})) or on() (vector(0) and on() (count(up) > 0)))[28d:5m])",
          "legendFormat": "attainment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Share of measured 5-minute samples in the last 28 days where every Kustomization that is not suspended was Ready. Target 99%."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kustomizations",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\", ready=\"True\"}) or vector(0)",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\", ready!=\"True\"}) or vector(0)",
          "legendFormat": "not ready"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "count(flux_resource_info{kind=\"Kustomization\", suspended=\"True\"}) or vector(0)",
          "legendFormat": "suspended"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "All Kustomizations Ready",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "((count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\", ready=\"True\"}) == bool count(flux_resource_info{kind=\"Kustomization\", suspended=\"False\"})) or on() (vector(0) and on() (count(up) > 0)))",
          "legendFormat": "all ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "1 when every Kustomization that is not suspended is Ready; 0 when one is not, or when the operator reports nothing while scraping works."
    },
    {
      "id": 4,
      "type": "table",
      "title": "Not Ready resources",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "flux_resource_info{ready!=\"True\", suspended=\"False\"}",
          "legendFormat": "{{kind}} {{exported_namespace}}/{{name}} {{reason}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Suspended resources",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "flux_resource_info{suspended=\"True\"}",
          "legendFormat": "{{kind}} {{exported_namespace}}/{{name}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Reconcile duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(gotk_reconcile_duration_seconds_bucket[10m])))",
          "interval": "1m",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
